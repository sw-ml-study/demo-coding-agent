# Rust build output for the optional agent-tools extension.
/target/
**/target/

# Locally built native extension artifacts.
*.dylib
*.so
*.dll

# Generated agent transcripts, scratch workspaces, and local tool output.
/out/
# Scratch for scripts (tangle checks, FIFOs, replay output) and for org-babel; never /tmp.
/work/
/tmp/
*.tmp
/tests/scratch/*
!/tests/scratch/.gitkeep

# Local environment and tool overrides.
.env
.env.*
!.env.example

# Platform/editor metadata.
.DS_Store
*.swp
*~

# Recorded demos: demos/*.tape are source and tracked; only the README's
# assets/demo/loop.gif is tracked (re-record deliberately with just demo-tape).
/assets/demo/*
!/assets/demo/loop.gif

# Temporary local preview page.
/animations/

# Org export artifacts (C-c C-e h o); the .org file is the source.
/docs/*.html
