#!/bin/sh
set -eu

# Replay the saved live transcript through the real loop with typewriter
# pacing, then restore the example project. No model server needed.
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_dir/scripts/select-mlpl")
transcript=${REPLAY_TRANSCRIPT:-fixtures/transcripts/mlpl-mul-qwen2.5-coder-7b.txt}
delay=${REPLAY_DELAY:-0.06}
mkdir -p "$repo_dir/work"
out=$repo_dir/work/replay.$$.txt

status=0
"$mlpl" --source-dir "$repo_dir" -f "$repo_dir/agents/run_replay.mlpl" -- "$transcript" > "$out" 2>&1 || status=$?
while IFS= read -r line; do
    printf '%s\n' "$line"
    sleep "$delay"
done < "$out"
rm -f "$out"

git -C "$repo_dir" checkout -q -- examples/tiny-mlpl-project
git -C "$repo_dir" clean -fdq -- examples/tiny-mlpl-project
echo "restored examples/tiny-mlpl-project"
echo "mlplcode replay complete"
exit "$status"
