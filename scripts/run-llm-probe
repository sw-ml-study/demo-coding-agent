#!/bin/sh
set -eu

# Opt-in live probe of llm_call. Never part of `just check`.
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_dir/scripts/select-mlpl")
set -- $("$repo_dir/scripts/check-ollama")

exec "$mlpl" --source-dir "$repo_dir" -f "$repo_dir/probes/llm_call_probe.mlpl" -- "$1" "$2"
