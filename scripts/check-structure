#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

for path in AGENTS.md COPYRIGHT LICENSE README.md justfile \
    docs/architecture.md docs/cross-repo-handoffs.md docs/permissions.md \
    docs/plan.md docs/progression.md docs/research.txt docs/sagas.md \
    docs/sw-mlpl-capabilities.md mlplunit.conf examples/tiny-rust-project/Cargo.toml \
    examples/tiny-rust-project/src/lib.rs probes/llm_call_probe.mlpl \
    agents/v0_read_think.mlpl agents/run_v0.mlpl agents/protocol.mlpl agents/loop.mlpl \
    agents/run_loop.mlpl agents/model.mlpl agents/tools.mlpl prompts/think.md prompts/act.md assets/mlplcode-logo.png \
    examples/tiny-mlpl-project/lib.mlpl examples/tiny-mlpl-project/tests/test_add.mlpl \
    examples/tiny-mlpl-project/vendor/mlplunit.mlpl examples/tiny-mlpl-project/vendor/VENDOR.md \
    fixtures/transcripts/mlpl-mul-qwen2.5-coder-7b.txt scripts/run-mlpl-demo \
    demos/loop.tape demos/loop-live.tape scripts/record-demo scripts/run-replay \
    agents/replay_loop.mlpl agents/run_replay.mlpl assets/demo/loop.gif \
    probes/decide_prompt_probe.mlpl scripts/check-decide-prompt; do
    if [ ! -f "$repo_dir/$path" ]; then
        echo "missing required file: $path" >&2
        exit 1
    fi
done

cmp -s "$repo_dir/COPYRIGHT" "$repo_dir/../demo-ml-microscope/COPYRIGHT" || {
    echo "COPYRIGHT differs from peer repository" >&2
    exit 1
}
cmp -s "$repo_dir/LICENSE" "$repo_dir/../demo-ml-microscope/LICENSE" || {
    echo "LICENSE differs from peer repository" >&2
    exit 1
}

grep -q 'agentrail:global:start' "$repo_dir/AGENTS.md"
grep -q 'Distributed under the \[MIT License\](LICENSE)' "$repo_dir/README.md"
echo "structure: required files, peer license, briefing markers present"
