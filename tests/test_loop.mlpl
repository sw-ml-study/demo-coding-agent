# Prove the bounded loop with scripted transcripts: flow, policy, stop reasons, parse errors.
include "agents/loop.mlpl";

def u:allow_all() {
  "Permissions that allow every tool.";
  {read: "allow", search: "allow", write: "allow", run: "allow", git: "allow", shell: "deny"}
}

def u:ask_writes() {
  "Permissions where writes must be approved.";
  {read: "allow", search: "allow", write: "ask", run: "allow", git: "ask", shell: "deny"}
}

def u:transcript_write_note() {
  "A three-turn transcript: read the fixture, write a scratch note, finish.";
  call(:u:ask_transcript, ["READ examples/tiny-rust-project/src/lib.rs", "WRITE tests/scratch/loop-note.txt\nadd exists\nEND", "DONE wrote a note"])
}

@test {name: "loop context is TASK, WORK SO FAR, then the instruction", tags: ["loop", "prompt"]}
def u:test_build_context() {
  "Pin the exact context layout.";
  state = u:loop_initial_state("fix it", 3);
  u:assert_text_eq(u:build_context(state), "TASK:\nfix it\n\nWORK SO FAR:\n\n\nChoose the next action.", "context")
}

@test {name: "authorize is a pure lookup by tool", tags: ["loop", "policy"]}
def u:test_authorize() {
  "Prove allow, ask, deny come straight from the permissions record and done is always allowed.";
  permissions = {read: "allow", search: "deny", write: "ask", run: "deny", git: "ask", shell: "deny"};
  u:assert_text_eq(u:authorize({tool: "read", path: "a"}, permissions), "allow", "read")?;
  u:assert_text_eq(u:authorize({tool: "write", path: "a", body: ""}, permissions), "ask", "write")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["mlpl", "t.mlpl"]}, permissions), "deny", "run mlpl uses run")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["cargo", "test"]}, permissions), "deny", "run cargo uses run")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["git", "status"]}, permissions), "ask", "run git uses git")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["rm", "-rf", "x"]}, permissions), "deny", "anything else is shell")?;
  u:assert_text_eq(u:authorize({tool: "search", text: "x"}, permissions), "deny", "search")?;
  u:assert_text_eq(u:authorize({tool: "done", summary: "x"}, permissions), "allow", "done")
}

@test {name: "transcript model replies by counting prior actions", tags: ["loop", "fake-model"]}
def u:test_ask_transcript() {
  "Prove the scripted model is pure over the prompt and exhausts to DONE.";
  ask = call(:u:ask_transcript, ["READ a", "DONE b"]);
  u:assert_text_eq(call(ask, "TASK:\nx\n\nWORK SO FAR:\n\n\nChoose"), "READ a", "turn 0")?;
  u:assert_text_eq(call(ask, "x\n\nACTION:\nREAD a\n\nOBSERVATION:\nstuff"), "DONE b", "turn 1")?;
  u:assert_text_eq(call(ask, "\nACTION:\n1\nACTION:\n2"), "DONE transcript exhausted", "exhausted")
}

@test {name: "loop reads, writes, and finishes with DONE", tags: ["loop", "flow"]}
def u:test_loop_read_write_done() {
  "End to end with allow-all: three steps, file written, history carries the source, files lists both paths.";
  final = u:run_loop("make a note", 6, u:transcript_write_note(), u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(final.reason, "done", "stop reason")?;
  u:assert_eq(final.iteration, 3, "three steps")?;
  u:assert_text_eq(final.answer, "wrote a note", "summary is the answer")?;
  u:assert_true(str_find(final.history, "pub fn add") > 0, "read observation in history")?;
  u:assert_true(str_find(final.history, "wrote tests/scratch/loop-note.txt") > 0, "write observation in history")?;
  u:assert_text_eq(final.files, "examples/tiny-rust-project/src/lib.rs\ntests/scratch/loop-note.txt\n", "touched files")?;
  u:assert_text_eq(unwrap(read_text("tests/scratch/loop-note.txt")), "add exists\n", "file content")?;
  u:assert_ok(remove_path("tests/scratch/loop-note.txt"), "cleanup")
}

@test {name: "a denied write stops the loop without writing", tags: ["loop", "policy"]}
def u:test_loop_denied_write() {
  "With write: deny the second step stops with reason denied and no file appears.";
  permissions = {read: "allow", search: "allow", write: "deny", run: "allow", git: "allow", shell: "deny"};
  final = u:run_loop("make a note", 6, u:transcript_write_note(), permissions, :u:decide_yes, :u:verify_always);
  u:assert_text_eq(final.reason, "denied", "stop reason")?;
  u:assert_eq(final.iteration, 2, "stopped on the write")?;
  u:assert_eq(str_find(final.answer, "denied: WRITE tests/scratch/loop-note.txt"), 0, "answer names the action")?;
  u:assert_err(read_text("tests/scratch/loop-note.txt"), "nothing written")
}

@test {name: "ask resolves through the injected decision", tags: ["loop", "policy", "ask"]}
def u:test_loop_ask_decision() {
  "Refused ask stops as denied; approved ask writes and finishes.";
  refused = u:run_loop("make a note", 6, u:transcript_write_note(), u:ask_writes(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(refused.reason, "denied", "refused")?;
  u:assert_err(read_text("tests/scratch/loop-note.txt"), "refused write absent")?;
  approved = u:run_loop("make a note", 6, u:transcript_write_note(), u:ask_writes(), :u:decide_yes, :u:verify_always);
  u:assert_text_eq(approved.reason, "done", "approved")?;
  u:assert_ok(read_text("tests/scratch/loop-note.txt"), "approved write present")?;
  u:assert_ok(remove_path("tests/scratch/loop-note.txt"), "cleanup")
}

@test {name: "an exhausted budget stops the loop", tags: ["loop", "budget"]}
def u:test_loop_budget() {
  "A model that never finishes is cut off after budget steps with reason budget.";
  ask = call(:u:ask_transcript, ["READ tests/fixtures/plain.txt", "READ tests/fixtures/child_ok.mlpl", "READ tests/fixtures/plain.txt", "READ tests/fixtures/child_ok.mlpl"]);
  final = u:run_loop("loop forever", 3, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(final.reason, "budget", "stop reason")?;
  u:assert_eq(final.iteration, 3, "exactly budget steps")?;
  u:assert_eq(u:count_occurrences(final.history, "\nACTION:\n"), 3, "three actions recorded")
}

@test {name: "a malformed reply becomes a PARSE ERROR observation and the loop continues", tags: ["loop", "parse"]}
def u:test_loop_parse_error_continues() {
  "The model sees its own protocol mistake and can recover within the budget.";
  ask = call(:u:ask_transcript, ["Sure, let me look.", "DONE recovered"]);
  final = u:run_loop("x", 4, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(final.reason, "done", "recovered")?;
  u:assert_eq(final.iteration, 2, "two steps")?;
  u:assert_true(str_find(final.history, "PARSE ERROR: unknown verb: Sure, let me look.") > 0, "parse error observed")
}

@test {name: "a failed read is an ERROR observation, not a crash", tags: ["loop", "error"]}
def u:test_loop_read_error_observed() {
  "Builtin errs flow into history as text so the model can choose again.";
  ask = call(:u:ask_transcript, ["READ examples/tiny-rust-project/src/nope.rs", "DONE gave up"]);
  final = u:run_loop("x", 4, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(final.reason, "done", "finished")?;
  u:assert_true(str_find(final.history, "ERROR: read_text:") > 0, "error observed")
}

@test {name: "without the extension SEARCH and RUN cargo say so, and shell stops the run", tags: ["loop", "policy"]}
def u:test_loop_without_extension() {
  "No library loaded: search and cargo observe that the extension is missing; a shell command is denied and ends the run.";
  ask = call(:u:ask_transcript, ["SEARCH pub fn", "RUN cargo test", "RUN rm -rf examples", "DONE never"]);
  final = u:run_loop("x", 6, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_true(str_find(final.history, "search needs the agent-tools extension (not loaded)") > 0, "search observation")?;
  u:assert_true(str_find(final.history, "run: cargo needs the agent-tools extension (not loaded)") > 0, "cargo observation")?;
  u:assert_text_eq(final.reason, "denied", "shell denied stops the run")?;
  u:assert_eq(str_find(final.answer, "denied: RUN rm -rf examples"), 0, "the shell command is named")?;
  u:assert_text_eq(final.files, "", "no files touched")
}

@test {name: "the policy table holds row by row", tags: ["loop", "policy"]}
def u:test_policy_table() {
  "docs/permissions.md: read and search allow, write ask, run allow for mlpl and cargo, git ask, shell deny.";
  live = {read: "allow", search: "allow", write: "ask", run: "allow", git: "ask", shell: "deny"};
  u:assert_text_eq(u:authorize({tool: "read", path: "a"}, live), "allow", "read")?;
  u:assert_text_eq(u:authorize({tool: "search", text: "a"}, live), "allow", "search")?;
  u:assert_text_eq(u:authorize({tool: "write", path: "a", body: ""}, live), "ask", "write")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["mlpl", "t.mlpl"]}, live), "allow", "run mlpl")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["cargo", "test"]}, live), "allow", "run cargo")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["git", "diff"]}, live), "ask", "run git")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: ["sh", "-c", "x"]}, live), "deny", "run shell")?;
  u:assert_text_eq(u:authorize({tool: "run", argv: []}, live), "deny", "empty run is shell")?;
  u:assert_text_eq(u:authorize({tool: "done", summary: "x"}, live), "allow", "done")
}

@test {name: "RUN mlpl executes the example tests and observes the results", tags: ["loop", "run"]}
def u:test_loop_run_mlpl() {
  "The loop's RUN reaches run_script and the model sees status and per-test lines.";
  ask = call(:u:ask_transcript, ["RUN mlpl examples/tiny-mlpl-project/tests/test_add.mlpl", "DONE tests pass"]);
  final = u:run_loop("run the tests", 4, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(final.reason, "done", "finished")?;
  u:assert_true(str_find(final.history, "status: ok") > 0, "status observed")?;
  u:assert_true(str_find(final.history, "passed: add sums two numbers") > 0, "test line observed")
}

@test {name: "verify_tests_passed reads the evidence from history", tags: ["loop", "verify"]}
def u:test_verify_tests_passed() {
  "No run, a run before the last write, a failed test, and a clean run after the last write.";
  base = u:loop_initial_state("t", 5);
  u:assert_err(u:verify_tests_passed(base), "empty history")?;
  ran_only = u:advanced(base, "RUN mlpl t.mlpl", "status: ok\npassed: a", "");
  u:assert_err(u:verify_tests_passed(ran_only), "passing run but nothing written")?;
  ran_then_wrote = u:advanced(ran_only, "WRITE a.txt\nx\nEND", "wrote a.txt", "a.txt");
  u:assert_err(u:verify_tests_passed(ran_then_wrote), "write after run")?;
  wrote = u:advanced(base, "WRITE a.txt\nx\nEND", "wrote a.txt", "a.txt");
  failed = u:advanced(wrote, "RUN mlpl t.mlpl", "status: err\npassed: a\nfailed: b -- boom", "");
  u:assert_err(u:verify_tests_passed(failed), "status err")?;
  ok_but_failed = u:advanced(wrote, "RUN mlpl t.mlpl", "status: ok\nfailed: b -- boom", "");
  u:assert_err(u:verify_tests_passed(ok_but_failed), "failed line after status")?;
  clean = u:advanced(ran_then_wrote, "RUN mlpl t.mlpl", "status: ok\npassed: a\npassed: b", "");
  u:assert_ok(u:verify_tests_passed(clean), "run after write, all passed")
}

@test {name: "an unverified DONE becomes an observation and the loop continues", tags: ["loop", "verify"]}
def u:test_loop_unverified_done_continues() {
  "The model claims success without running; the loop says NOT VERIFIED, then accepts DONE after a passing RUN.";
  ask = call(:u:ask_transcript, ["DONE all tests pass", "WRITE tests/scratch/verify-note.txt\nnote\nEND", "RUN mlpl examples/tiny-mlpl-project/tests/test_add.mlpl", "DONE now they really pass"]);
  final = u:run_loop("run the tests", 6, ask, u:allow_all(), :u:decide_no, :u:verify_tests_passed);
  u:assert_ok(remove_path("tests/scratch/verify-note.txt"), "cleanup")?;
  u:assert_text_eq(final.reason, "done", "eventually done")?;
  u:assert_eq(final.iteration, 4, "four steps")?;
  u:assert_true(str_find(final.history, "NOT VERIFIED: no file has been written yet") > 0, "first DONE refused")?;
  u:assert_text_eq(final.answer, "now they really pass", "second DONE accepted")
}

@test {name: "a write to an existing unread file is refused until it is read", tags: ["loop", "guard"]}
def u:test_loop_read_before_write() {
  "Blind edit refused with guidance; after a READ the same write goes through; a new file needs no read.";
  ask = call(:u:ask_transcript, ["WRITE tests/fixtures/plain.txt\nx\nEND", "READ tests/fixtures/plain.txt", "WRITE tests/scratch/guard-new.txt\nnew\nEND", "DONE ok"]);
  original = unwrap(read_text("tests/fixtures/plain.txt"));
  final = u:run_loop("edit", 6, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_ok(remove_path("tests/scratch/guard-new.txt"), "cleanup")?;
  u:assert_text_eq(unwrap(read_text("tests/fixtures/plain.txt")), original, "fixture untouched")?;
  u:assert_true(str_find(final.history, "read tests/fixtures/plain.txt before writing it") > 0, "guidance observed")?;
  u:assert_true(str_find(final.history, "wrote tests/scratch/guard-new.txt") > 0, "new file allowed without a read")?;
  u:assert_text_eq(final.reason, "done", "finished")
}

@test {name: "a write after reading the file is allowed", tags: ["loop", "guard"]}
def u:test_loop_write_after_read() {
  "The guard keys on state.files, so READ then WRITE of the same path executes.";
  ask = call(:u:ask_transcript, ["READ examples/tiny-mlpl-project/lib.mlpl", "WRITE examples/tiny-mlpl-project/lib.mlpl\n# rewritten\nEND", "DONE ok"]);
  original = unwrap(read_text("examples/tiny-mlpl-project/lib.mlpl"));
  final = u:run_loop("edit", 5, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  write_atomic("examples/tiny-mlpl-project/lib.mlpl", original)?;
  u:assert_true(str_find(final.history, "wrote examples/tiny-mlpl-project/lib.mlpl") > 0, "write executed")?;
  u:assert_eq(str_find(final.history, "before writing it"), -1, "no guard message")
}

@test {name: "an identical reply is flagged once and stops the loop the third time", tags: ["loop", "guard"]}
def u:test_loop_repeated_action() {
  "Second identical reply observes REPEATED ACTION without executing; third stops with reason stuck.";
  ask = call(:u:ask_transcript, ["READ tests/fixtures/plain.txt", "READ tests/fixtures/plain.txt", "READ tests/fixtures/plain.txt", "DONE never reached"]);
  final = u:run_loop("loop", 6, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(final.reason, "stuck", "stop reason")?;
  u:assert_eq(final.iteration, 3, "three steps")?;
  u:assert_eq(u:count_occurrences(final.history, "REPEATED ACTION"), 1, "flagged exactly once")?;
  u:assert_eq(u:count_occurrences(final.history, "alpha\nbeta"), 1, "the read executed only once")
}

@test {name: "a changed reply resets the repeat count", tags: ["loop", "guard"]}
def u:test_loop_repeat_reset() {
  "Alternating replies never trip the guard.";
  ask = call(:u:ask_transcript, ["READ tests/fixtures/plain.txt", "READ tests/fixtures/child_ok.mlpl", "READ tests/fixtures/plain.txt", "DONE ok"]);
  final = u:run_loop("alternate", 6, ask, u:allow_all(), :u:decide_no, :u:verify_always);
  u:assert_text_eq(final.reason, "done", "finished")?;
  u:assert_eq(str_find(final.history, "REPEATED ACTION"), -1, "never flagged")
}

@test {name: "PATCH edits a read file in place and needs the file read first", tags: ["loop", "patch"]}
def u:test_loop_patch() {
  "A PATCH before READ is refused with guidance; after READ it applies and the file is listed as touched.";
  path = "tests/scratch/loop-patch.txt";
  u:assert_ok(write_text(path, "one\ntwo\nthree\n"), "fixture")?;
  ask = call(:u:ask_transcript, [str_join(["PATCH ", path, "\nOLD\ntwo\nNEW\n2\nEND"], ""), str_concat("READ ", path), str_join(["PATCH ", path, "\nOLD\ntwo\nNEW\n2\nEND"], ""), "DONE ok"]);
  final = u:run_loop("edit", 6, ask, u:ask_writes(), :u:decide_yes, :u:verify_always);
  content = unwrap(read_text(path));
  u:assert_ok(remove_path(path), "cleanup")?;
  u:assert_true(str_find(final.history, str_concat("read ", str_concat(path, " before writing it"))) > 0, "guard first")?;
  u:assert_true(str_find(final.history, str_concat("patched ", path)) > 0, "patched after read")?;
  u:assert_text_eq(content, "one\n2\nthree\n", "content patched")?;
  u:assert_text_eq(final.reason, "done", "finished")
}

@test {name: "verify accepts a patched file plus a passing cargo-style run", tags: ["loop", "verify", "patch"]}
def u:test_verify_patch_and_cargo() {
  "status: 0 from the extension counts as passing; cargo FAILED output does not.";
  base = u:loop_initial_state("t", 5);
  patched = u:advanced(base, "PATCH src/lib.rs\nOLD\na\nNEW\nb\nEND", "patched src/lib.rs", "src/lib.rs");
  passing = u:advanced(patched, "RUN cargo test", "status: 0\nstdout:\ntest result: ok. 1 passed; 0 failed;\nstderr:\n", "");
  u:assert_ok(u:verify_tests_passed(passing), "cargo pass")?;
  failing = u:advanced(patched, "RUN cargo test", "status: 0\nstdout:\ntest result: FAILED. 0 passed; 1 failed;\nstderr:\n", "");
  u:assert_err(u:verify_tests_passed(failing), "cargo FAILED text")?;
  nonzero = u:advanced(patched, "RUN cargo test", "status: 101\nstdout:\n\nstderr:\nerror\n", "");
  u:assert_err(u:verify_tests_passed(nonzero), "non-zero status")?;
  stale = u:advanced(passing, "PATCH src/lib.rs\nOLD\nb\nNEW\nc\nEND", "patched src/lib.rs", "src/lib.rs");
  u:assert_err(u:verify_tests_passed(stale), "patch after the passing run")
}

u:run_registered_tests()
